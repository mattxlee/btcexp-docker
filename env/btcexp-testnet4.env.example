# PUBLIC host, testnet4 instance. Copy to /etc/btcexp/btcexp-testnet4.env,
# replace placeholders, keep private, then start with:
#   docker compose -f docker-compose.btcexp.yml \
#     --env-file /etc/btcexp/btcexp-testnet4.env -p btcexp-testnet4 up -d

COMPOSE_PROJECT_NAME=btcexp-testnet4

# Redis lives on this host (btcexp's own cache); never share it with mainnet.
HOST_REDIS_DATA_DIR=/srv/btcexp/testnet4/redis

IMAGE_TAG=latest
# btcexp/btcidx use the generic testnet identifier for Bitcoin Core testnet4.
NETWORK=testnet
PUB_WEB_PORT=8089
# Host-side bind address for the web port. Keep 127.0.0.1 when a TLS reverse
# proxy on this host fronts it; use 0.0.0.0 (or a specific IP) only to serve
# plain HTTP directly.
PUB_WEB_BIND=127.0.0.1

RATHOLE_CONFIG_FILE=/etc/btcexp/btcexp-testnet4-rathole.toml
# Different from the mainnet instance's control port on the same host.
RATHOLE_CONTROL_PORT=2334

# Public origin read by btcexp for canonical URLs, Open Graph and sitemap.
APP_URL=https://testnet4.intgrow.com
# GA4 measurement ID. TODO: fill in once the testnet4 property exists.
# Empty disables analytics.
GA_ID=
# External BTC price quote endpoint; empty disables the price card.
PRICE_API_URL=https://price.intgrow.com
PRICE_INST_ID=BTC-USDT
# Network-switch links in the header; empty hides a link.
MAINNET_URL=https://www.intgrow.com
TESTNET4_URL=https://testnet4.intgrow.com
# JSON API/Swagger are off unless explicitly enabled.
API_ENABLED=false

# Optional: raise if Electrum queries time out over the tunnel (image defaults).
# ELECTRUM_CONNECT_TIMEOUT_SECS=10
# ELECTRUM_READ_TIMEOUT_SECS=20
