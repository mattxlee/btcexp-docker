# LAN host, mainnet instance. Copy to /etc/btcexp/btcidx-mainnet.env,
# replace placeholders, keep private, then start with:
#   docker compose -f docker-compose.btcidx.yml \
#     --env-file /etc/btcexp/btcidx-mainnet.env -p btcidx-mainnet up -d

COMPOSE_PROJECT_NAME=btcidx-mainnet
# Must be the same absolute path passed to --env-file, so btcidx receives the
# RPC/ZMQ values below.
BTCIDX_ENV_FILE=/etc/btcexp/btcidx-mainnet.env

HOST_BTCIDX_DATA_DIR=/srv/btcexp/mainnet/btcidx
HOST_REDIS_DATA_DIR=/srv/btcexp/mainnet/redis

IMAGE_TAG=latest
NETWORK=mainnet

# rathole client config (server address, token, noise public key). Keep it
# outside the checkout if the checkout is shared.
RATHOLE_CONFIG_FILE=/etc/btcexp/btcidx-mainnet-rathole.toml

# Use the actual private endpoint configured for the mainnet Bitcoin Core node.
BTCIDX_RPC_URL=http://host.docker.internal:8332
BTCIDX_RPC_USER=replace-with-mainnet-rpc-user
BTCIDX_RPC_PASS=replace-with-mainnet-rpc-password
# BTCIDX_RPC_COOKIE_FILE=/path/in-container/to/.cookie

BTCIDX_ZMQ_ENABLED=true
BTCIDX_ZMQ_ENDPOINT=tcp://host.docker.internal:28332
