# Copy to /etc/btcexp/mainnet.env, replace placeholders, and keep it private.
# Start with:
# docker compose --env-file /etc/btcexp/mainnet.env -p btcexp-mainnet up -d

COMPOSE_PROJECT_NAME=btcexp-mainnet
BTCIDX_ENV_FILE=/etc/btcexp/mainnet.env

HOST_BTCIDX_DATA_DIR=/srv/btcexp/mainnet/btcidx
HOST_REDIS_DATA_DIR=/srv/btcexp/mainnet/redis

IMAGE_TAG=latest
NETWORK=mainnet
PUB_WEB_PORT=8088

# Use the actual private endpoint configured for the mainnet Bitcoin Core node.
BTCIDX_RPC_URL=http://host.docker.internal:8332
BTCIDX_RPC_USER=replace-with-mainnet-rpc-user
BTCIDX_RPC_PASS=replace-with-mainnet-rpc-password
# BTCIDX_RPC_COOKIE_FILE=/path/in-container/to/.cookie

BTCIDX_ZMQ_ENABLED=true
BTCIDX_ZMQ_ENDPOINT=tcp://host.docker.internal:28332
