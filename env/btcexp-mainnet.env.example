# PUBLIC host, mainnet instance. Copy to /etc/btcexp/btcexp-mainnet.env,
# replace placeholders, keep private, then start with:
#   docker compose -f docker-compose.btcexp.yml \
#     --env-file /etc/btcexp/btcexp-mainnet.env -p btcexp-mainnet up -d

COMPOSE_PROJECT_NAME=btcexp-mainnet

# Redis lives on this host (btcexp's own cache).
HOST_REDIS_DATA_DIR=/srv/btcexp/mainnet/redis

IMAGE_TAG=latest
NETWORK=mainnet
PUB_WEB_PORT=8088

# rathole server config (private key, service tokens). Keep it outside the
# checkout if the checkout is shared.
RATHOLE_CONFIG_FILE=/etc/btcexp/btcexp-mainnet-rathole.toml
# Host port published for the tunnel control channel; must be reachable from
# the LAN host and unique per instance on this host. Container side stays 2333.
RATHOLE_CONTROL_PORT=2333

# Public origin read by btcexp for canonical URLs, Open Graph and sitemap.
# Must include the scheme, no trailing slash.
APP_URL=https://www.intgrow.com
# GA4 measurement ID for this instance; empty disables analytics.
GA_ID=G-24M49RN8J6
# External BTC price quote endpoint; empty disables the price card.
PRICE_API_URL=https://price.intgrow.com
PRICE_INST_ID=BTC-USDT
# Network-switch links in the header; empty hides a link.
MAINNET_URL=https://www.intgrow.com
TESTNET4_URL=https://testnet4.intgrow.com
# JSON API/Swagger are off unless explicitly enabled.
API_ENABLED=false
# API_KEY=replace-with-a-long-random-key

# Optional: raise if Electrum queries time out over the tunnel (image defaults).
# ELECTRUM_CONNECT_TIMEOUT_SECS=10
# ELECTRUM_READ_TIMEOUT_SECS=20
