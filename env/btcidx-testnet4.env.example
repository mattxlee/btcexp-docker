# LAN host, testnet4 instance. Copy to /etc/btcexp/btcidx-testnet4.env,
# replace placeholders, keep private, then start with:
#   docker compose -f docker-compose.btcidx.yml \
#     --env-file /etc/btcexp/btcidx-testnet4.env -p btcidx-testnet4 up -d

COMPOSE_PROJECT_NAME=btcidx-testnet4
# Must be the same absolute path passed to --env-file.
BTCIDX_ENV_FILE=/etc/btcexp/btcidx-testnet4.env

HOST_BTCIDX_DATA_DIR=/srv/btcexp/testnet4/btcidx
HOST_REDIS_DATA_DIR=/srv/btcexp/testnet4/redis

IMAGE_TAG=latest
# btcexp/btcidx use the generic testnet identifier for Bitcoin Core testnet4.
NETWORK=testnet

RATHOLE_CONFIG_FILE=/etc/btcexp/btcidx-testnet4-rathole.toml

# Verify the actual RPC/ZMQ ports configured on this host's testnet4 node.
# Bitcoin Core commonly defaults testnet4 RPC to 48332 unless overridden.
BTCIDX_RPC_URL=http://host.docker.internal:48332
BTCIDX_RPC_USER=replace-with-testnet4-rpc-user
BTCIDX_RPC_PASS=replace-with-testnet4-rpc-password
# BTCIDX_RPC_COOKIE_FILE=/path/in-container/to/.cookie

BTCIDX_ZMQ_ENABLED=true
# Use a dedicated, private testnet4 ZMQ listener; do not reuse mainnet's port.
BTCIDX_ZMQ_ENDPOINT=tcp://host.docker.internal:28333
