# ---------------------------------------------------------------------------
# btcexp-docker environment
# Copy to .env:  cp .env.example .env
# Docker Compose reads this file for ${...} interpolation, and it is also
# passed to the btcidx container via env_file (all BTCIDX_* vars are its config).
#
# Only deployment-specific settings live here: project name, storage paths, the
# single published port, and the bitcoind connection. Everything else is fixed
# in docker-compose.yml. For multiple networks on one host, copy this template
# outside the checkout (for example to /etc/btcexp/mainnet.env) and launch with
# both --env-file and -p; see README.md.

# Compose project name. This scopes containers and the btcexp-net network.
COMPOSE_PROJECT_NAME=btcexp
# File injected into btcidx. Keep it identical to the --env-file path used to
# start this instance, so btcidx receives the matching RPC/ZMQ settings.
BTCIDX_ENV_FILE=.env
# ---------------------------------------------------------------------------

# ---- Host storage paths (bind mounts) -------------------------------------
# Use absolute, instance-specific paths when multiple networks run on one host;
# btcidx RocksDB and Redis persistence must never be shared between instances.
# Relative paths are resolved from this compose directory.
HOST_BTCIDX_DATA_DIR=./data/btcidx
HOST_REDIS_DATA_DIR=./data/redis

# ---- Container images (ghcr.io/mattxlee/*) --------------------------------
# Tag applied to all three intgrow images ("latest" or a pinned version).
IMAGE_TAG=latest
# Optional full image overrides (rarely needed):
# BTCIDX_IMAGE=ghcr.io/mattxlee/btcidx
# BTCEXP_IMAGE=ghcr.io/mattxlee/btcexp
# BTCEXPFR_IMAGE=ghcr.io/mattxlee/btcexpfr

# ---- Network --------------------------------------------------------------
# mainnet | signet | testnet | regtest  (must be supported by your bitcoind).
# A Bitcoin Core testnet4 node uses NETWORK=testnet in btcidx/btcexp.
NETWORK=signet

# ---- Published port (the only host-published port) -------------------------
# Web UI / API gateway (btcexpfr). It binds to 127.0.0.1 by default; put a
# TLS reverse proxy in front of it for access beyond this host. Container port
# stays 80.
PUB_WEB_PORT=8088

# ---- bitcoind RPC / ZMQ (btcidx) ------------------------------------------
# bitcoind is expected on the Docker host; host.docker.internal is mapped via
# extra_hosts. The ZMQ endpoint is a container-side outbound destination, not a
# Docker-published port. Bind bitcoind ZMQ to the Docker bridge or another
# private interface; do not bind it to a public interface. Use an IP instead
# if your setup resolves differently.
# NOTE: pick the RPC/ZMQ port matching NETWORK (signet RPC 38332, testnet
# 18332, regtest 18443).
BTCIDX_RPC_URL=http://host.docker.internal:8332
BTCIDX_RPC_USER=bitcoin
BTCIDX_RPC_PASS=change-me
# To use cookie auth instead, comment out RPC_USER/RPC_PASS and uncomment:
# BTCIDX_RPC_COOKIE_FILE=/home/bitcoin/.bitcoin/.cookie

BTCIDX_ZMQ_ENABLED=true
BTCIDX_ZMQ_ENDPOINT=tcp://host.docker.internal:28332
